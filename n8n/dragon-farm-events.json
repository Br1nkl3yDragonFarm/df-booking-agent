      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Turns each Dragon Farm event into a one-line message plus a sheet row.\nconst e = $('Webhook').item.json.body || {};\nconst d = e.data || {};\nconst lead = d.lead || d;\nconst money = n => n ? '$' + Number(n).toLocaleString('en-US') : '';\nconst when = lead.eventDate ? new Date(lead.eventDate + 'T12:00:00').toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' }) : '';\nconst where = [lead.name, lead.city].filter(Boolean).join(', ');\nconst clock = t => { const [h, m] = String(t || '').split(':').map(Number); return isNaN(h) ? (t || '') : `${h % 12 || 12}:${String(m || 0).padStart(2, '0')} ${h < 12 ? 'AM' : 'PM'}`; };\nconst pay = lead.dealType === 'door' ? (lead.doorPct ? lead.doorPct + '% of the door' : 'door deal') : money(lead.guarantee);\nconst text = {\n  'show.booked': `🎸 Booked: ${lead.artist || 'the band'} at ${where}${when ? ' on ' + when : ''}${lead.setTime ? ', ' + clock(lead.setTime) : ''}${pay ? ' · ' + pay : ''}`,\n  'sync.licensed': `🎬 Licensed: ${lead.name}${lead.project ? ' for ' + lead.project : ''}${lead.fee ? ' · ' + lead.fee : ''}`,\n  'brand.signed': `🤝 Signed: ${lead.name}${lead.offer ? ' · ' + lead.offer : ''}`,\n  'reply.received': `📬 Reply from ${d.from || 'someone'}: ${d.subject || ''}${d.snippet ? '\\n> ' + d.snippet : ''}`,\n  'payment.received': `💵 Paid: ${money(d.amount)} ${d.kind || ''} from ${where || 'a buyer'}${d.invoice ? ' (' + d.invoice + ')' : ''}`,\n  'agreement.signed': `✍️ Signed by ${d.signedBy || 'the buyer'}${d.role ? ' (' + d.role + ')' : ''}: ${d.title || 'agreement'}${d.pdf ? '\\n' + d.pdf : ''}`,\n  'inquiry.received': `📥 New inquiry: ${where}${lead.eventDate ? ' for ' + lead.eventDate : ''}${lead.contactName ? ' from ' + lead.contactName : ''}`,\n  'fan.signed_up': `🙌 New fan${d.city ? ' in ' + d.city : ''}${d.show ? ' at ' + d.show : ''} · ${d.fans || '?'} on the list`,\n  'digest.sent': `🗓️ Monday rundown sent: ${d.subject || ''}`,\n  test: `✅ Test from the Dragon Farm booking tool`\n}[e.type] || `Dragon Farm event: ${e.type}`;\n// A row for the Google Sheet log: Shows, Payments or Fans tab (column name → value).\nconst logged = new Date(e.at || Date.now()).toLocaleString('en-US', { timeZone: 'America/Chicago' });\nconst sheet = {\n  'show.booked': ['Shows', { 'Show date': lead.eventDate || '', Venue: lead.name || '', City: lead.city || '', Artist: lead.artist || '', 'Set time': clock(lead.setTime), Pay: pay || '', Contact: lead.contactName || '', Email: lead.contactEmail || '' }],\n  'payment.received': ['Payments', { Amount: d.amount || '', Kind: d.kind || '', Invoice: d.invoice || '', Venue: lead.name || '', City: lead.city || '', 'Show date': lead.eventDate || '' }],\n  'fan.signed_up': ['Fans', { Email: d.email || '', Name: d.name || '', Town: d.city || '', Show: d.show || '', 'Fans on list': d.fans || '' }]\n}[e.type];\n// A phone alert (ntfy) for the events worth an interruption.\nconst dash = (e.site || '') + '/dashboard.html';\nconst alert = {\n  'payment.received': { title: `💵 ${money(d.amount)} ${d.kind || 'payment'} paid`, message: [where, lead.eventDate && 'show ' + lead.eventDate, d.invoice].filter(Boolean).join(' · ') || 'Card payment received', priority: 4, tags: ['moneybag'] },\n  'reply.received': { title: `📬 Reply from ${String(d.from || 'someone').replace(/\\s*<.*>$/, '')}`, message: [d.subject, d.snippet].filter(Boolean).join('\\n') || 'New reply to a pitch', priority: 4, tags: ['envelope'] }\n}[e.type];\nreturn { json: {\n  type: e.type,\n  sample: !!d.sample,\n  message: (d.sample ? '[sample] ' : '') + text,\n  alert: alert ? { ...alert, title: (d.sample ? '[sample] ' : '') + alert.title, click: dash } : null,\n  sheet: sheet ? { tab: sheet[0], row: { Logged: logged, Sample: d.sample ? 'yes' : '', ...sheet[1] } } : null,\n  event: e\n} };"
      },
