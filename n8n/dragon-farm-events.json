      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Turns each Dragon Farm event into a one-line message plus a sheet row.\nconst e = $('Webhook').item.json.body || {};\nconst d = e.data || {};\nconst lead = d.lead || d;\nconst money = n => n ? '$' + Number(n).toLocaleString('en-US') : '';\nconst when = lead.eventDate ? new Date(lead.eventDate + 'T12:00:00').toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' }) : '';\nconst where = [lead.name, lead.city].filter(Boolean).join(', ');\nconst clock = t => { const [h, m] = String(t || '').split(':').map(Number); return isNaN(h) ? (t || '') : `${h % 12 || 12}:${String(m || 0).padStart(2, '0')} ${h < 12 ? 'AM' : 'PM'}`; };\nconst pay = lead.dealType === 'door' ? (lead.doorPct ? lead.doorPct + '% of the door' : 'door deal') : money(lead.guarantee);\nconst text = {\n  'show.booked': `🎸 Booked: ${lead.artist || 'the band'} at ${where}${when ? ' on ' + when : ''}${lead.setTime ? ', ' + clock(lead.setTime) : ''}${pay ? ' · ' + pay : ''}`,\n  'sync.licensed': `🎬 Licensed: ${lead.name}${lead.project ? ' for ' + lead.project : ''}${lead.fee ? ' · ' + lead.fee : ''}`,\n  'brand.signed': `🤝 Signed: ${lead.name}${lead.offer ? ' · ' + lead.offer : ''}`,\n  'reply.received': `📬 Reply from ${d.from || 'someone'}: ${d.subject || ''}${d.snippet ? '\\n> ' + d.snippet : ''}`,\n  'payment.received': `💵 Paid: ${money(d.amount)} ${d.kind || ''} from ${where || 'a buyer'}${d.invoice ? ' (' + d.invoice + ')' : ''}`,\n  'agreement.signed': `✍️ Signed by ${d.signedBy || 'the buyer'}${d.role ? ' (' + d.role + ')' : ''}: ${d.title || 'agreement'}${d.pdf ? '\\n' + d.pdf : ''}`,\n  'inquiry.received': `📥 New inquiry: ${where}${lead.eventDate ? ' for ' + lead.eventDate : ''}${lead.contactName ? ' from ' + lead.contactName : ''}`,\n  'fan.signed_up': `🙌 New fan${d.city ? ' in ' + d.city : ''}${d.show ? ' at ' + d.show : ''} · ${d.fans || '?'} on the list`,\n  'digest.sent': `🗓️ Monday rundown sent: ${d.subject || ''}`,\n  test: `✅ Test from the Dragon Farm booking tool`\n}[e.type] || `Dragon Farm event: ${e.type}`;\nreturn { json: {\n  type: e.type,\n  sample: !!d.sample,\n  message: (d.sample ? '[sample] ' : '') + text,\n  row: { When: e.at, Event: e.type, Who: where || d.from || d.email || '', Date: lead.eventDate || '', Amount: d.amount || lead.guarantee || lead.fee || '', Sample: d.sample ? 'yes' : '' },\n  event: e\n} };"
      },
